# Iyzico credentials are required for real checkout sessions.
# Do not put real values in this file — names only.
#
# IYZICO_BASE_URL must stay https://sandbox-api.iyzipay.com until production
# go-live is explicitly approved.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# Public site origin, used to build the iyzico callback URL
# (https://<domain>/api/payment/callback). Must be HTTPS in production.
NEXT_PUBLIC_SITE_URL=

# Required for Firestore payment persistence. Must be the explicit GCP/Firebase
# project ID this app should write to — never left unset, and never inferred
# from the ambient gcloud CLI project or a developer's local credentials.
# See lib/firebase-admin.ts.
FIREBASE_PROJECT_ID=

# Optional. Path to a service-account JSON key file, used in production.
# If unset, applicationDefault() falls back to `gcloud auth application-default
# login` credentials locally, or compute metadata credentials on GCP
# infrastructure. FIREBASE_PROJECT_ID above always determines which project is
# used, regardless of which of these credential sources is active.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional. When "true", Firestore persistence failures in the payment flow
# are raised instead of logged-and-continued. Leave unset until real Firebase
# Admin credentials are confirmed configured for this deployment.
PAYMENT_PERSISTENCE_STRICT=

# Required to run payment reconciliation (GET/POST /api/payment/reconcile).
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`
# when configured as a project env var and referenced by vercel.json's
# `crons` entry. Generate a long random value (e.g. `openssl rand -hex 32`).
# The route fails closed (401) if this is unset — never leave it blank in
# any environment where /api/payment/reconcile is reachable.
CRON_SECRET=
